<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <servlet>
        <servlet-name>JdbcServlet</servlet-name>
        <servlet-class>com.sibvisions.rjdbc.server.JdbcServlet</servlet-class>
        
   		<init-param>
		    <param-name>allowedJdbcUrls</param-name>
		    <param-value>*</param-value>
		</init-param>

		<init-param>
		    <param-name>environment</param-name>
		    <param-value>development</param-value>
		</init-param>
		    
        <!--  
		
		<init-param>
		    <param-name>environment</param-name>
		    <param-value>production</param-value>
		</init-param>
		
		<init-param>
		    <param-name>jdbcUrl</param-name>
		    <param-value>jdbc:oracle:thin:@localhost:1521/XE</param-value>
		</init-param>    

		<init-param>
		    <param-name>jdbcUsername</param-name>
		    <param-value>...</param-value>
		</init-param>
		
		<init-param>
		    <param-name>jdbcPassword</param-name>
		    <param-value>...</param-value>
		</init-param>
        -->
        
    	<init-param>
		    <param-name>token</param-name>
		    <param-value>rjdbc-test-token</param-value>
		</init-param>
		
		<init-param>
		    <param-name>privateKey</param-name>
		    <param-value>/com/sibvisions/rjdbc/server/rjdbc-server-test.p12</param-value>
		</init-param>
		
		<init-param>
		    <param-name>privateKeyPassword</param-name>
		    <param-value>rjdbc-test-password</param-value>
		</init-param>
		
		<init-param>
		    <param-name>privateKeyAlias</param-name>
		    <param-value>rjdbc-server</param-value>
		</init-param>		
          
    </servlet>
    
     
    <servlet-mapping>
        <servlet-name>JdbcServlet</servlet-name>
        <url-pattern>/jdbc/*</url-pattern>
    </servlet-mapping>

</web-app>